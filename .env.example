# Copy to .env and fill in. Never commit .env.

# AI provider (docs/decisions.md #7): gemini (default) | fake (offline, canned sentences) | claude | openai
# (claude and openai are not built yet). With no key the app runs with the fixed phrases only.
# Check the key with: uv run python scripts/test_gemini.py --send
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Default gemini-3.8-flash. Any model id from the Gemini API model list works.
GEMINI_MODEL=

# Real sends. true (the default) only logs what would be sent and the board shows "(demo mode)".
# Set to false to really send Telegram messages and place Twilio calls after a confirm.
ACTIONS_DRY_RUN=true

# Telegram bot for text messages (no SMS: see docs/decisions.md #2).
# Create a bot with @BotFather, have each contact press Start in a chat with it, then read their
# chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_MARIA=
TELEGRAM_CHAT_ID_CARLOS=
TELEGRAM_CHAT_ID_NURSE=

# Twilio Programmable Voice for calls. All numbers E.164, e.g. +13055550123.
# On a trial account, numbers you call must be verified in the Twilio console (error 21219).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional <Say> voices, e.g. Polly.Mia / Polly.Joanna. Left out = Twilio's default voice.
TWILIO_VOICE_ES=
TWILIO_VOICE_EN=

# Contact phone numbers (names match phone_env in data/contacts.yaml)
CONTACT_MARIA_PHONE=
CONTACT_CARLOS_PHONE=
CONTACT_NURSE_PHONE=

# Voice (docs/decisions.md #3). Left empty = browser speech only; the app works the same.
# Key: elevenlabs.io > Developers > API Keys (needs Text to Speech access). Voice id: Voices >
# pick a voice > "Copy voice ID". Check with: uv run python scripts/test_voice.py
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Make audio for the whole menu (both languages) in the background at startup, once; about 4,000
# characters of the free tier's 10,000 a month. Cached files are never requested again.
ELEVENLABS_PREWARM=true

# Signal source: keyboard | synthetic | replay | muse
SOURCE=keyboard

# Core server port
CORE_PORT=8000

# Ranking prior with TypeSafe Jev (docs/decisions.md #6), optional. Left empty = ranking by history
# and time of day only; the app works the same. The first one set is used:
#   a) TypeSafe API key
TYPESAFE_API_KEY=
#   Default jev-latest.
TYPESAFE_MODEL=
#   b) Cloudflare Workers AI (model typesafe/jev): account id and an API token with Workers AI access
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Check with: uv run python scripts/test_jev.py --send

# --- Trip route map (optional; the board draws an offline map without it) -------------------------
# A Google Maps JavaScript API key (Maps JavaScript API enabled, billing on). It is sent to the
# browser like any Maps JS key: restrict it to http://localhost:5173/* and 5174/*. The route drawn is
# our open-data route from /api/geo/trip (no Google Directions; docs/decisions.md #23).
VITE_GOOGLE_MAPS_API_KEY=

# Trip planning (/trip/live only, docs/decisions.md #22), optional. Google Places accessibility and
# Street View, fetched live, never stored or scored. Left empty = the live page says the key is
# missing; /trip works the same (open data only). Enable Places API (New) and Street View Static API.
GOOGLE_MAPS_API_KEY=
