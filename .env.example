# Copy to .env and fill in. Never commit .env.

# AI provider: gemini | claude | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Twilio (texts and calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Signal source: keyboard | synthetic | replay | muse
SOURCE=keyboard

# Core server port
CORE_PORT=8000
